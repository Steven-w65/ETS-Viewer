QWidget {
    color: @text_primary@;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 10.5pt;
}
QMainWindow, QDialog { background: @background@; }
QLabel { background: transparent; border: none; }
QFrame { border: none; }
QWidget#header {
    background: @background@;
    border-bottom: 1px solid @border@;
}
QWidget#sidebar, QWidget#sidebarRail { background: @sidebar@; }
QFrame#readingWorkspace, QScrollArea#partNavigation, QWidget#readingNavigation {
    background: @workspace@;
}
QFrame#panel, QFrame#statCard {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
}
QFrame#detailHeader {
    background: @workspace@;
    border-bottom: 1px solid @border@;
}
QLabel#appTitle { font-size: 11pt; font-weight: 600; }
QLabel#workspaceTitle { font-size: 20pt; font-weight: 600; }
QLabel#panelTitle { font-size: 11pt; font-weight: 600; }
QLabel#subtitle, QLabel#panelSubtitle { color: @text_secondary@; font-size: 10pt; }
QLabel#sourcePath, QLabel#folderPath {
    color: @text_muted@;
    font-size: 9.5pt;
    padding: 0;
}
QLabel#paperDate { color: @text_secondary@; font-size: 9.5pt; }
QLabel#eyebrow { color: @text_secondary@; font-size: 9pt; font-weight: 600; }
QLabel#countBadge {
    background: @surface_selected@;
    color: @text_secondary@;
    border-radius: 5px;
    padding: 3px 7px;
    font-size: 9pt;
}
QLabel#statValue { font-size: 24pt; font-weight: 600; }
QLabel#statLabel { color: @text_secondary@; font-size: 10pt; }
QLabel#emptyTitle { font-size: 20pt; font-weight: 600; }
QLabel#emptyDescription { color: @text_secondary@; font-size: 11pt; }
QLabel#matchLabel { color: @text_secondary@; font-size: 9.5pt; }
QWidget#toast {
    background: @surface@;
    color: @text_primary@;
    border: 1px solid @border_hover@;
    border-radius: 8px;
    padding: 9px 15px;
}

QPushButton, QToolButton {
    color: @text_primary@;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 22px;
}
QPushButton:hover, QToolButton:hover { background: @surface_hover@; }
QPushButton:pressed, QToolButton:pressed { background: @surface_selected@; }
QPushButton:checked, QToolButton:checked {
    background: @surface_selected@;
    border-color: @border@;
}
QPushButton:focus, QToolButton:focus { border-color: @border_focus@; }
QPushButton:disabled, QToolButton:disabled { color: @disabled_text@; }
QPushButton#selectFolder {
    background: @surface@;
    border-color: @border@;
    padding: 8px 13px;
    font-weight: 500;
}
QPushButton#selectFolder:hover { background: @surface_hover@; border-color: @border_hover@; }
QPushButton#selectFolder:pressed { background: @surface_selected@; }
QPushButton#selectFolder:focus { border-color: @border_focus@; }
QPushButton#selectFolder:disabled { background: @disabled_background@; color: @disabled_text@; }
QPushButton#exportAnswers {
    background: @surface@;
    border-color: @border@;
    padding: 5px 10px;
    font-size: 9.5pt;
}
QPushButton#exportAnswers:hover { background: @surface_hover@; border-color: @border_hover@; }
QPushButton#exportAnswers:pressed { background: @surface_selected@; }
QPushButton#exportAnswers:focus { border-color: @border_focus@; }
QPushButton#exportAnswers:disabled { background: @disabled_background@; color: @disabled_text@; }
QPushButton#backButton { text-align: left; }
QPushButton#navButton { padding: 4px 11px; min-height: 22px; }
QPushButton#answerToggle, QPushButton#sharedToggle {
    background: @surface@;
    border-color: @border@;
    padding: 0 8px;
    font-size: 9.5pt;
    min-height: 0;
}
QPushButton#answerToggle:hover, QPushButton#sharedToggle:hover {
    background: @surface_hover@;
    border-color: @border_hover@;
}
QPushButton#answerToggle:pressed, QPushButton#sharedToggle:pressed { background: @surface_selected@; }
QPushButton#answerToggle:focus, QPushButton#sharedToggle:focus { border-color: @border_focus@; }
QPushButton#scanNotes {
    color: @warning@;
    padding: 3px 8px;
    font-size: 9.5pt;
    min-height: 18px;
}
QToolButton#sidebarToggle, QToolButton#settingsButton {
    padding: 5px;
    min-width: 24px;
    min-height: 24px;
}
QToolButton#settingsButton::menu-indicator { subcontrol-position: center right; }

QLineEdit {
    background: @surface@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 7px 10px;
    min-height: 22px;
    placeholder-text-color: @text_muted@;
    selection-background-color: @surface_selected@;
    selection-color: @selection_text@;
}
QLineEdit:hover { border-color: @border_hover@; }
QLineEdit:focus { border-color: @border_focus@; }
QLineEdit:disabled { background: @disabled_background@; color: @disabled_text@; }
QLineEdit#search { padding: 8px 11px; }

QTreeView {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
    selection-background-color: @surface_selected@;
    selection-color: @selection_text@;
}
QTreeView::item { border: none; background: transparent; }
QTreeView::item:hover { background: @surface_hover@; }
QTreeView::item:selected { background: @surface_selected@; }
QTreeView::branch { background: transparent; }
QTextBrowser {
    background: @workspace@;
    color: @text_primary@;
    border: none;
    selection-background-color: @surface_selected@;
    selection-color: @selection_text@;
}

QMenu {
    background: @surface@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item { padding: 7px 27px 7px 12px; border-radius: 4px; }
QMenu::item:selected { background: @surface_hover@; color: @text_primary@; }
QMenu::item:disabled { color: @text_muted@; }
QMenu::separator { height: 1px; background: @border@; margin: 5px 8px; }
QMenu::section { color: @text_secondary@; padding: 6px 12px; font-size: 9pt; }
QToolTip {
    background: @surface@;
    color: @text_primary@;
    border: 1px solid @border@;
    padding: 5px 8px;
    font-size: 9.5pt;
}
QMessageBox, QMessageBox QLabel { background: @background@; }

QSplitter#contentSplitter::handle:horizontal { background: @border@; width: 1px; }
QSplitter#contentSplitter::handle:horizontal:hover { background: @border_hover@; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: @scrollbar@; min-height: 32px; border-radius: 3px; }
QScrollBar::handle:horizontal { background: @scrollbar@; min-width: 32px; border-radius: 3px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: @scrollbar_hover@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

QStatusBar {
    background: @sidebar@;
    color: @text_secondary@;
    border-top: 1px solid @border@;
    padding: 4px 14px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @text_secondary@; font-size: 9.5pt; }
QProgressBar {
    background: @surface_selected@;
    color: @text_secondary@;
    border: none;
    border-radius: 3px;
    min-height: 5px;
    text-align: center;
}
QProgressBar::chunk { background: @text_muted@; border-radius: 3px; }
