QMainWindow, QWidget {
    background: #10151e;
    color: #dce5f4;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 10pt;
}
QLabel { background: transparent; }
QFrame#panel {
    background: #171e2a;
    border: 1px solid #2a3446;
    border-radius: 10px;
}
QPushButton#selectFolder {
    background: #9cb3ff;
    color: #13213f;
    border: 1px solid transparent;
    border-radius: 8px;
    font-weight: 600;
    padding: 12px 22px;
    min-width: 110px;
}
QPushButton#selectFolder:hover { background: #b1c3ff; }
QPushButton#selectFolder:pressed { background: #809be9; }
QPushButton#selectFolder:focus { border-color: #e0e8ff; }
QPushButton#selectFolder:disabled { background: #384966; color: #91a1bb; }
QLineEdit#search {
    background: #192130;
    color: #ecf1fb;
    border: 1px solid #303c52;
    border-radius: 8px;
    padding: 12px 15px;
    placeholder-text-color: #8f9fb7;
    selection-background-color: #334f7c;
    selection-color: #f3f6fc;
}
QLineEdit#search:hover { border-color: #455675; }
QLineEdit#search:focus { border-color: #89a7ef; background: #1b273a; }
QLabel#eyebrow { color: #9aadd1; font-size: 9pt; font-weight: 600; padding-left: 2px; }
QLabel#folderPath { color: #96a6bd; font-size: 9.5pt; padding-left: 2px; }
QLabel#panelTitle { background: transparent; color: #dfe7f5; font-size: 10.5pt; font-weight: 600; }
QLabel#panelSubtitle { color: #8f9fb9; font-size: 9.5pt; }
QLabel#paperDate {
    background: #223044;
    color: #bbcee9;
    border: 1px solid #3a4c68;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 9pt;
}
QLabel#countBadge {
    background: #263149;
    color: #bbccf8;
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 9.5pt;
}
QTreeView {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}
QTreeView::item, QTreeView::item:hover, QTreeView::item:selected {
    background: transparent;
    border: none;
}
QPushButton#answerToggle {
    background: #1e4036;
    color: #bddfcf;
    border: 1px solid #3b6655;
    border-radius: 5px;
    padding: 0 7px;
    font-size: 9pt;
    font-weight: 500;
    text-align: center;
}
QPushButton#answerToggle:hover { background: #2b5143; border-color: #65987f; color: #e1f7eb; }
QPushButton#answerToggle:pressed { background: #183a2f; border-color: #537e68; }
QPushButton#answerToggle:focus { border-color: #8ebda7; }
QTextBrowser {
    background: #171e2a;
    color: #e3e9f3;
    border: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    selection-background-color: #334f7c;
    selection-color: #f3f6fc;
}
QFrame#detailHeader {
    background: transparent;
    border: none;
    border-bottom: 1px solid #2a3446;
}
QLabel#sourcePath {
    background: transparent;
    color: #a0afc5;
    border: none;
    padding: 0;
    font-size: 9.5pt;
}
QPushButton#exportAnswers {
    background: #23344e;
    color: #ceddf5;
    border: 1px solid #496181;
    border-radius: 5px;
    padding: 0 10px;
    font-size: 9pt;
    font-weight: 500;
}
QPushButton#exportAnswers:hover { background: #30496b; border-color: #7698c5; color: #eef4ff; }
QPushButton#exportAnswers:pressed { background: #1b2c44; border-color: #6081aa; }
QPushButton#exportAnswers:focus { border-color: #9cb3ff; }
QSplitter#contentSplitter::handle:horizontal {
    background: transparent;
    border: none;
}
QScrollBar:vertical { background: transparent; width: 10px; margin: 3px; }
QScrollBar::handle:vertical { background: #42536f; min-height: 32px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: #6a83a7; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QStatusBar { background: #10151e; color: #96a6bf; border: none; padding: 5px 14px; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #96a6bf; font-size: 9.5pt; }
QPushButton#scanNotes {
    color: #c7b686;
    background: transparent;
    border: 1px solid #514b3c;
    border-radius: 5px;
    padding: 4px 9px;
    font-size: 9.5pt;
}
QPushButton#scanNotes:hover { background: #302c24; }
QPushButton#scanNotes:focus { border-color: #89a7ef; }
QPushButton#scanNotes:pressed { background: #3a3426; }
QProgressBar { background: #263149; border: none; border-radius: 3px; }
QProgressBar::chunk { background: #9cb3ff; border-radius: 3px; }
QMessageBox, QMessageBox QLabel { background: #171e2a; }
QMessageBox QPushButton { background: #2a3955; border: none; border-radius: 5px; padding: 8px 16px; }
QMessageBox QPushButton:hover { background: #354b70; }
QMessageBox QPushButton:focus { border: 1px solid #89a7ef; }
QToolTip {
    background: #233044;
    color: #dce5f4;
    border: 1px solid #3b4b64;
    padding: 5px 8px;
    font-size: 9.5pt;
}
